/**
 * Five flame-sensor analog outputs: ADC0 channels 0..4 -> MEM0..MEM4.
 * Software-triggered single sequence; MEM4 result marks completion.
 * VDDA must actually be 3.3 V; the voltage metadata does not set supply voltage.
 * 40 us acquisition is an initial setting; verify against sensor output impedance.
 */
const ADC12 = scripting.addModule("/ti/driverlib/ADC12", {}, false);
const ADC121 = ADC12.addInstance();
ADC121.$name = "fire_adc";
ADC121.peripheral.$assign = "ADC0";
ADC121.sampClkSrc = "DL_ADC12_CLOCK_ULPCLK";
ADC121.sampClkDiv = "DL_ADC12_CLOCK_DIVIDE_8";
ADC121.powerDownMode = "DL_ADC12_POWER_DOWN_MODE_MANUAL";
ADC121.resolution = "DL_ADC12_SAMP_CONV_RES_12_BIT";
ADC121.samplingOperationMode = "sequence";
ADC121.startAdd = 0;
ADC121.endAdd = 4;
ADC121.repeatMode = false;
ADC121.sampleTime0 = "40 us";
ADC121.enabledInterrupts = ["DL_ADC12_INTERRUPT_MEM4_RESULT_LOADED"];
ADC121.adcMem0_name = "fire0";
ADC121.adcMem1_name = "fire1";
ADC121.adcMem2_name = "fire2";
ADC121.adcMem3_name = "fire3";
ADC121.adcMem4_name = "fire4";
ADC121.adcMem0chansel = "DL_ADC12_INPUT_CHAN_0";
ADC121.adcMem1chansel = "DL_ADC12_INPUT_CHAN_1";
ADC121.adcMem2chansel = "DL_ADC12_INPUT_CHAN_2";
ADC121.adcMem3chansel = "DL_ADC12_INPUT_CHAN_3";
ADC121.adcMem4chansel = "DL_ADC12_INPUT_CHAN_4";
ADC121.adcMem0vref = "VDDA";
ADC121.adcMem1vref = "VDDA";
ADC121.adcMem2vref = "VDDA";
ADC121.adcMem3vref = "VDDA";
ADC121.adcMem4vref = "VDDA";
ADC121.peripheral.adcPin0.$assign = "PA27";
ADC121.peripheral.adcPin1.$assign = "PA26";
ADC121.peripheral.adcPin2.$assign = "PA25";
ADC121.peripheral.adcPin3.$assign = "PA24";
ADC121.peripheral.adcPin4.$assign = "PB25";

/**
 * OLED I2C controller: external SDA/SCL pull-ups to 3.3 V required.
 * Start at standard-mode 100 kHz; select a faster rate only after checking the panel.
 */
const I2C = scripting.addModule("/ti/driverlib/I2C", {}, false);
const I2C1 = I2C.addInstance();
I2C1.$name = "I2C_oled";
I2C1.basicEnableController = true;
I2C1.basicEnableTarget = false;
I2C1.basicControllerBusSpeed = 100000;
I2C1.peripheral.$assign = "I2C0";
I2C1.peripheral.sdaPin.$assign = "PA28";
I2C1.peripheral.sclPin.$assign = "PA31";
I2C1.sdaPinConfig.$name = "I2C_oled_SDA";
I2C1.sclPinConfig.$name = "I2C_oled_SCL";

SYSCTL.forceDefaultClkConfig = true;

GPIO5.$name = "HCSR04";
