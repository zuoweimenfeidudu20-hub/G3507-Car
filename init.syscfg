GPIO5.associatedPins[0].interruptEn = true;
GPIO5.associatedPins[0].polarity = "RISE_FALL";
GPIO5.associatedPins[0].pin.$assign = "PA1";
GPIO5.associatedPins[1].$name = "TRIG";
GPIO5.associatedPins[1].pin.$assign = "PB14";

