{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MSPM0: Build",
      "type": "process",
      "command": "C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build.ps1"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": "$gcc"
    },
    {
      "label": "MSPM0: Check wireless connection",
      "type": "process",
      "command": "C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/probe.ps1", "-Action", "Check"],
      "problemMatcher": []
    },
    {
      "label": "MSPM0: Build and flash",
      "type": "process",
      "command": "C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/probe.ps1", "-Action", "Flash"],
      "dependsOn": "MSPM0: Build",
      "problemMatcher": []
    },
    {
      "label": "MSPM0: Open SysConfig",
      "type": "process",
      "command": "C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build.ps1", "-Action", "SysConfig"],
      "problemMatcher": []
    }
  ]
}
