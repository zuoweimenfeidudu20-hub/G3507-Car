{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MSPM0G3507 - XDS110 attach (no flash)",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/init.out",
      "request": "attach",
      "type": "cortex-debug",
      "servertype": "openocd",
      "serverpath": "${workspaceFolder}/../mspm0-tools/openocd-new/openocd/bin/openocd.exe",
      "armToolchainPath": "${workspaceFolder}/../mspm0-tools/arm-none-eabi-gdb/arm-none-eabi-gdb_14.2.rel1",
